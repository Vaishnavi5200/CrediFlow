# RocketRide — Local Engine
ROCKETRIDE_URI=ws://localhost:49352
ROCKETRIDE_APIKEY=MYAPIKEY

# OpenAI (used by Agent A + Agent B in pipeline)
OPENAI_API_KEY=your_openai_api_key_here

# Email dispatch (SMTP — test sandbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=crediflow-noreply@crediflow.ai
SMTP_TEST_RECIPIENT=vendor-test@crediflow.ai

# Human Gate
HIGH_VALUE_THRESHOLD_INR=50000
CONFIDENCE_THRESHOLD=0.85

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
