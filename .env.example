# ==============================================================================
# CrediFlow Environment Configuration (Placeholders only — never commit secrets)
# ==============================================================================

# RocketRide Cloud / Local Engine Configuration
# For RocketRide Cloud: Provide your assigned wss:// URI and authentication key
# For Local Engine: e.g. ws://localhost:52257
ROCKETRIDE_URI=
ROCKETRIDE_AUTH=

# OpenAI API Key (injected server-side into RocketRide LLM nodes if needed)
OPENAI_API_KEY=

# Human Risk Gate Policy Settings
HIGH_VALUE_THRESHOLD_INR=50000
CONFIDENCE_THRESHOLD=0.85

# Email Dispatch Sandbox (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# App Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
