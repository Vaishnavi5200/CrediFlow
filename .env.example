# ==============================================================================
# CrediFlow Environment Configuration (Template — Never commit actual secrets)
# ==============================================================================

# ─── LLM Explanation Layer (Optional - Gemini / Groq / OpenAI) ────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── Statutory Human-in-the-Loop Gate Thresholds ──────────────────────────────
# Invoices with exposure >= HIGH_VALUE_THRESHOLD_INR require mandatory human sign-off
HIGH_VALUE_THRESHOLD_INR=50000
# Decisions with confidence < CONFIDENCE_THRESHOLD trigger human review
CONFIDENCE_THRESHOLD=0.85

# ─── Real-World Action Dispatch (Optional SMTP) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── WhatsApp Business API (Optional — Primary delivery channel) ──────────────
# If not set, /api/whatsapp/send automatically falls back to wa.me deep-link.
# WHATSAPP_API_TOKEN:       Permanent System User Access Token from Meta Business Manager
# WHATSAPP_PHONE_NUMBER_ID: Phone Number ID from Meta Business Manager > WhatsApp > API Setup
# WHATSAPP_API_VERSION:     Meta Graph API version (default: v20.0)
# NEVER expose these in frontend code or client-side bundles.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# ─── Server Runtime Settings ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
