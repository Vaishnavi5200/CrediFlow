# ==============================================================================
# CrediFlow Environment Configuration (Template — Never commit actual secrets)
# ==============================================================================

# ─── RocketRide Configuration ─────────────────────────────────────────────────
# IMPORTANT: RocketRide authentication requires a PRIVATE API KEY starting with 'rr_'
# (Generate this under RocketRide -> User Settings -> API Keys).
# Do NOT use a Publishable Key starting with 'pk_', which causes 401/400 errors.

# Priority 1: RocketRide Webhook (HTTPS POST to deployed pipeline endpoint)
ROCKETRIDE_WEBHOOK_URL=https://staging.rocketride.ai/webhook/...
ROCKETRIDE_WEBHOOK_TOKEN=rr_your_private_token_here

# Priority 2: RocketRide Cloud / Local Engine (WebSocket SDK connection)
# RocketRide Cloud workspace URI (e.g. wss://app.rocketride.ai/engine/...)
ROCKETRIDE_URI=wss://api.rocketride.ai
ROCKETRIDE_AUTH=rr_your_private_token_here

# ─── LLM Provider (Optional - for direct node key injection) ──────────────────
OPENAI_API_KEY=sk-...

# ─── Statutory Human-in-the-Loop Gate Thresholds ──────────────────────────────
# Invoices with exposure >= HIGH_VALUE_THRESHOLD_INR require mandatory human sign-off
HIGH_VALUE_THRESHOLD_INR=50000
# AI decisions with confidence < CONFIDENCE_THRESHOLD trigger human review
CONFIDENCE_THRESHOLD=0.85

# ─── Real-World Action Dispatch (Optional SMTP) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Server Runtime Settings ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
